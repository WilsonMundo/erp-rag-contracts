{
  "$defs": {
    "DashboardFilterBindingV1": {
      "additionalProperties": false,
      "properties": {
        "dashboard_filter_binding_version": {
          "const": "1.0",
          "title": "Dashboard Filter Binding Version",
          "type": "string"
        },
        "filter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Filter Id",
          "type": "string"
        },
        "mappings": {
          "items": {
            "$ref": "#/$defs/DashboardFilterMappingV1"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Mappings",
          "type": "array"
        }
      },
      "required": [
        "dashboard_filter_binding_version",
        "filter_id",
        "mappings"
      ],
      "title": "DashboardFilterBindingV1",
      "type": "object"
    },
    "DashboardFilterMappingV1": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "entity_binding": {
                "type": "string"
              }
            },
            "required": [
              "entity_binding"
            ]
          },
          "then": {
            "properties": {
              "source_path": {
                "const": "value"
              }
            }
          }
        }
      ],
      "properties": {
        "dashboard_filter_mapping_version": {
          "const": "1.0",
          "title": "Dashboard Filter Mapping Version",
          "type": "string"
        },
        "entity_binding": {
          "anyOf": [
            {
              "enum": [
                "entity_id",
                "binding_value"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Binding"
        },
        "source_path": {
          "enum": [
            "value",
            "start",
            "end_exclusive"
          ],
          "title": "Source Path",
          "type": "string"
        },
        "target_parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Target Parameter",
          "type": "string"
        }
      },
      "required": [
        "dashboard_filter_mapping_version",
        "source_path",
        "target_parameter"
      ],
      "title": "DashboardFilterMappingV1",
      "type": "object"
    },
    "DashboardFilterV1": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "entity_type": {
                "type": "string"
              }
            },
            "required": [
              "entity_type"
            ]
          },
          "then": {
            "properties": {
              "value_type": {
                "const": "entity"
              }
            },
            "required": [
              "value_type"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "date_range"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "date_range"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "enum": [
                  "integer",
                  "decimal",
                  "boolean",
                  "string",
                  "entity"
                ]
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "type": {
                "const": "scalar"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "min_value": {
                    "type": "number"
                  }
                },
                "required": [
                  "min_value"
                ]
              },
              {
                "properties": {
                  "max_value": {
                    "type": "number"
                  }
                },
                "required": [
                  "max_value"
                ]
              }
            ]
          },
          "then": {
            "properties": {
              "value_type": {
                "enum": [
                  "integer",
                  "decimal"
                ]
              }
            },
            "required": [
              "value_type"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "impact": {
                "type": "string"
              }
            },
            "required": [
              "impact"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "type": "string"
              }
            },
            "required": [
              "scope"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "presentation"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "impact": {
                "const": "presentation"
              }
            },
            "required": [
              "impact"
            ]
          }
        },
        {
          "not": {
            "properties": {
              "impact": {
                "const": "presentation"
              },
              "scope": {
                "const": "data"
              }
            },
            "required": [
              "scope",
              "impact"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "default_value": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "default_value"
            ]
          },
          "then": {
            "properties": {
              "value_type": {
                "type": "string"
              }
            },
            "required": [
              "value_type"
            ]
          }
        }
      ],
      "properties": {
        "dashboard_filter_version": {
          "const": "1.0",
          "title": "Dashboard Filter Version",
          "type": "string"
        },
        "default_value": {
          "default": null,
          "type": [
            "object",
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "entity_type": {
          "default": null,
          "description": "Canonical Entity Resolution type. Optional for historical reads; required by new entity writes. No inference.",
          "enum": [
            "branch",
            "customer",
            "product",
            "supplier",
            "seller",
            "document",
            "classification_level",
            null
          ]
        },
        "filter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Filter Id",
          "type": "string"
        },
        "impact": {
          "default": null,
          "enum": [
            "query",
            "analysis",
            "presentation",
            null
          ]
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Label",
          "type": "string"
        },
        "max_value": {
          "default": null,
          "type": [
            "number",
            "null"
          ]
        },
        "min_value": {
          "default": null,
          "type": [
            "number",
            "null"
          ]
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "scope": {
          "default": null,
          "enum": [
            "data",
            "analysis",
            "presentation",
            null
          ]
        },
        "type": {
          "enum": [
            "scalar",
            "date_range"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "default": null,
          "pattern": "\\S",
          "type": [
            "string",
            "null"
          ]
        },
        "value_type": {
          "default": null,
          "enum": [
            "date_range",
            "integer",
            "decimal",
            "boolean",
            "string",
            "entity",
            null
          ]
        }
      },
      "required": [
        "dashboard_filter_version",
        "filter_id",
        "type",
        "label"
      ],
      "title": "DashboardFilterV1",
      "type": "object"
    },
    "DashboardGridLayoutV1": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "maximum": 24,
          "minimum": 1,
          "title": "Columns",
          "type": "integer"
        },
        "row_height": {
          "maximum": 500,
          "minimum": 1,
          "title": "Row Height",
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "row_height"
      ],
      "title": "DashboardGridLayoutV1",
      "type": "object"
    },
    "DashboardWidgetLayoutV1": {
      "additionalProperties": false,
      "properties": {
        "h": {
          "minimum": 1,
          "title": "H",
          "type": "integer"
        },
        "w": {
          "minimum": 1,
          "title": "W",
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "DashboardWidgetLayoutV1",
      "type": "object"
    },
    "DashboardWidgetV1": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "analytics_artifact_id": {
              "type": "null"
            },
            "query_artifact_id": {
              "type": "string"
            }
          },
          "required": [
            "query_artifact_id"
          ]
        },
        {
          "properties": {
            "analytics_artifact_id": {
              "type": "string"
            },
            "query_artifact_id": {
              "type": "null"
            }
          },
          "required": [
            "analytics_artifact_id"
          ]
        }
      ],
      "properties": {
        "analytics_artifact_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analytics Artifact Id"
        },
        "block_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Block Id",
          "type": "string"
        },
        "dashboard_widget_version": {
          "const": "1.0",
          "title": "Dashboard Widget Version",
          "type": "string"
        },
        "filter_bindings": {
          "items": {
            "$ref": "#/$defs/DashboardFilterBindingV1"
          },
          "maxItems": 20,
          "title": "Filter Bindings",
          "type": "array"
        },
        "layout": {
          "$ref": "#/$defs/DashboardWidgetLayoutV1"
        },
        "query_artifact_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Artifact Id"
        },
        "widget_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Widget Id",
          "type": "string"
        }
      },
      "required": [
        "dashboard_widget_version",
        "widget_id",
        "block_id",
        "layout",
        "filter_bindings"
      ],
      "title": "DashboardWidgetV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:dashboard-definition:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo runtime dashboard-definition versión 1.",
  "properties": {
    "dashboard_definition_version": {
      "const": "1.0",
      "title": "Dashboard Definition Version",
      "type": "string"
    },
    "dashboard_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Dashboard Id",
      "type": "string"
    },
    "global_filters": {
      "items": {
        "$ref": "#/$defs/DashboardFilterV1"
      },
      "maxItems": 20,
      "title": "Global Filters",
      "type": "array"
    },
    "grid_layout": {
      "$ref": "#/$defs/DashboardGridLayoutV1"
    },
    "status": {
      "enum": [
        "draft",
        "building",
        "ready",
        "published",
        "degraded",
        "archived"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "widgets": {
      "items": {
        "$ref": "#/$defs/DashboardWidgetV1"
      },
      "maxItems": 100,
      "title": "Widgets",
      "type": "array"
    }
  },
  "required": [
    "dashboard_definition_version",
    "dashboard_id",
    "title",
    "status",
    "global_filters",
    "widgets",
    "grid_layout"
  ],
  "title": "DashboardDefinitionV1",
  "type": "object"
}
