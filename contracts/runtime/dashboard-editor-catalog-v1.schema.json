{
  "$defs": {
    "DashboardEditorBindingOptionV1": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "entity_binding": {
                "type": "string"
              }
            },
            "required": [
              "entity_binding"
            ]
          },
          "then": {
            "properties": {
              "source_path": {
                "const": "value"
              }
            }
          }
        }
      ],
      "properties": {
        "dashboard_filter_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Dashboard Filter Id",
          "type": "string"
        },
        "entity_binding": {
          "anyOf": [
            {
              "enum": [
                "entity_id",
                "binding_value"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Binding"
        },
        "filter_label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Filter Label",
          "type": "string"
        },
        "source_path": {
          "enum": [
            "value",
            "start",
            "end_exclusive"
          ],
          "title": "Source Path",
          "type": "string"
        },
        "target_parameter": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Target Parameter",
          "type": "string"
        }
      },
      "required": [
        "dashboard_filter_id",
        "filter_label",
        "source_path",
        "target_parameter"
      ],
      "title": "DashboardEditorBindingOptionV1",
      "type": "object"
    },
    "DashboardEditorCatalogBlockV1": {
      "additionalProperties": false,
      "properties": {
        "binding_options": {
          "items": {
            "$ref": "#/$defs/DashboardEditorBindingOptionV1"
          },
          "title": "Binding Options",
          "type": "array"
        },
        "block_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Block Id",
          "type": "string"
        },
        "display_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Title",
          "type": "string"
        },
        "kind": {
          "enum": [
            "kpi",
            "comparison_kpi",
            "data_grid",
            "pivot_grid",
            "chart",
            "gauge",
            "table",
            "summary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "visual_type": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Type"
        }
      },
      "required": [
        "block_id",
        "kind",
        "display_title",
        "binding_options"
      ],
      "title": "DashboardEditorCatalogBlockV1",
      "type": "object"
    },
    "DashboardEditorCatalogItemV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/DashboardEditorCatalogBlockV1"
          },
          "minItems": 1,
          "title": "Blocks",
          "type": "array"
        },
        "display_title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Title",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "query",
            "analytics"
          ],
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "artifact_id",
        "display_title",
        "blocks"
      ],
      "title": "DashboardEditorCatalogItemV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:dashboard-editor-catalog:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo runtime dashboard-editor-catalog versión 1.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/DashboardEditorCatalogItemV1"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "items"
  ],
  "title": "DashboardEditorCatalogV1",
  "type": "object"
}
