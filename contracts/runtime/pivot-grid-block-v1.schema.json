{
  "$defs": {
    "PivotValueV1": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field",
        "aggregation"
      ],
      "title": "PivotValueV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:pivot-grid-block:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo runtime pivot-grid-block versión 1.",
  "properties": {
    "block_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Block Id",
      "type": "string"
    },
    "block_version": {
      "const": "1.0",
      "title": "Block Version",
      "type": "string"
    },
    "columns": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "type": "string"
      },
      "maxItems": 20,
      "title": "Columns",
      "type": "array"
    },
    "features": {
      "items": {
        "enum": [
          "rows",
          "columns",
          "values",
          "filtering",
          "sorting",
          "totals",
          "subtotals",
          "expand_collapse",
          "drilldown",
          "export"
        ],
        "type": "string"
      },
      "maxItems": 10,
      "title": "Features",
      "type": "array"
    },
    "kind": {
      "const": "pivot_grid",
      "title": "Kind",
      "type": "string"
    },
    "rows": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Rows",
      "type": "array"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/PivotValueV1"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Values",
      "type": "array"
    }
  },
  "required": [
    "block_version",
    "block_id",
    "kind",
    "title",
    "rows",
    "columns",
    "values"
  ],
  "title": "PivotGridBlockV1",
  "type": "object"
}
