{
  "$defs": {
    "ImportOperationV1": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Action Id",
          "type": "string"
        },
        "entity": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Entity",
          "type": "string"
        },
        "import_operation_version": {
          "const": "1.0",
          "title": "Import Operation Version",
          "type": "string"
        },
        "operation": {
          "const": "import",
          "title": "Operation",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Policy Id",
          "type": "string"
        },
        "write_mode": {
          "enum": [
            "create",
            "update",
            "upsert"
          ],
          "title": "Write Mode",
          "type": "string"
        }
      },
      "required": [
        "import_operation_version",
        "action_id",
        "entity",
        "operation",
        "write_mode",
        "policy_id"
      ],
      "title": "ImportOperationV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:import-capability-descriptor:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo runtime import-capability-descriptor versión 1.",
  "properties": {
    "accepted_mime_types": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Accepted Mime Types",
      "type": "array"
    },
    "action_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Action Id",
      "type": "string"
    },
    "confirmation_required": {
      "title": "Confirmation Required",
      "type": "boolean"
    },
    "import_capability_descriptor_version": {
      "const": "1.0",
      "title": "Import Capability Descriptor Version",
      "type": "string"
    },
    "max_bytes": {
      "minimum": 1,
      "title": "Max Bytes",
      "type": "integer"
    },
    "operation": {
      "$ref": "#/$defs/ImportOperationV1"
    }
  },
  "required": [
    "import_capability_descriptor_version",
    "action_id",
    "operation",
    "accepted_mime_types",
    "max_bytes",
    "confirmation_required"
  ],
  "title": "ImportCapabilityDescriptorV1",
  "type": "object"
}
