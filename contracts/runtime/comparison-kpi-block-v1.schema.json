          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Field",
          "type": "string"
        },
        "scope": {
