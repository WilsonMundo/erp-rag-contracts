          "title": "Scope",
          "type": "string"
        },
        "source": {
          "const": "result_aggregate",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "scope",
        "field",
        "aggregation"
      ],
      "title": "ResultAggregateValueReferenceV1",
      "type": "object"
    }
