            "auto",
            "number",
            "integer",
            "currency",
            "percent"
          ],
          "title": "Format",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "field": "#/$defs/FieldValueReferenceV1",
              "resolved_reference": "#/$defs/ResolvedReferenceValueReferenceV1",
              "result_aggregate": "#/$defs/ResultAggregateValueReferenceV1"
            },
            "propertyName": "source"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FieldValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResultAggregateValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResolvedReferenceValueReferenceV1"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "value"
      ],
      "title": "ComparisonKpiChangeV1",
      "type": "object"
    },
    "ComparisonKpiValueV1": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "default": "auto",
          "enum": [
            "auto",
            "number",
            "integer",
            "currency",
            "percent"
          ],
          "title": "Format",
          "type": "string"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
