          "type": "string"
        }
      },
      "required": [
        "source",
        "field"
      ],
      "title": "FieldValueReferenceV1",
      "type": "object"
    },
    "ResolvedReferenceValueReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Reference Id",
          "type": "string"
        },
        "source": {
          "const": "resolved_reference",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "reference_id"
      ],
      "title": "ResolvedReferenceValueReferenceV1",
      "type": "object"
    },
    "ResultAggregateValueReferenceV1": {
      "additionalProperties": false,
      "properties": {
