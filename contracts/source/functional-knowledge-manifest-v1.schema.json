{
  "$defs": {
    "FunctionalKnowledgeManifestEntryV1": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "table_schema",
            "table_family",
            "view_schema",
            "function_schema"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "document_version": {
          "title": "Document Version",
          "type": "integer"
        },
        "path": {
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$",
          "title": "Path",
          "type": "string"
        },
        "status": {
          "enum": [
            "approved",
            "draft",
            "needs_review",
            "deprecated"
          ],
          "title": "Status",
          "type": "string"
        },
        "usable_for_sql_generation": {
          "title": "Usable For Sql Generation",
          "type": "boolean"
        }
      },
      "required": [
        "document_id",
        "document_version",
        "document_type",
        "status",
        "usable_for_sql_generation",
        "path"
      ],
      "title": "FunctionalKnowledgeManifestEntryV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:functional-knowledge-manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo functional-knowledge-manifest versión 1.",
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/FunctionalKnowledgeManifestEntryV1"
      },
      "title": "Documents",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "documents"
  ],
  "title": "FunctionalKnowledgeManifestV1",
  "type": "object"
}
