  "$id": "urn:erp-rag-contracts:schema:reviewer-view-source:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo reviewer-view-source versión 1.",
  "properties": {
    "business_rules": {
      "items": {
        "$ref": "#/$defs/ViewBusinessRuleV1"
      },
      "title": "Business Rules",
      "type": "array"
    },
    "catalog_version": {
      "pattern": "^\\d{4}\\.\\d{2}$",
      "title": "Catalog Version",
      "type": "string"
    },
    "common_filters": {
      "items": {
        "type": "string"
      },
      "title": "Common Filters",
      "type": "array"
    },
    "common_outputs": {
      "items": {
        "type": "string"
      },
      "title": "Common Outputs",
      "type": "array"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "document_type": {
      "const": "view_schema",
      "title": "Document Type",
      "type": "string"
    },
    "document_version": {
      "exclusiveMinimum": 0,
      "title": "Document Version",
      "type": "integer"
    },
    "language": {
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
      "title": "Language",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/KnowledgeMetadataV1"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/RelationshipV1"
      },
      "title": "Relationships",
      "type": "array"
    },
    "retrieval": {
      "$ref": "#/$defs/KnowledgeRetrievalV1"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "approved",
        "draft",
        "needs_review",
        "deprecated"
      ],
      "title": "Status",
      "type": "string"
    },
    "usable_for_sql_generation": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Usable For Sql Generation"
    },
    "view": {
      "$ref": "#/$defs/ViewDefinitionV1"
    }
  },
