{
  "$defs": {
    "SourceManifestEntryV1": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_type": {
          "enum": [
            "table_schema",
            "table_family",
            "view_schema",
            "function_schema"
          ],
          "title": "Document Type",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "status": {
          "enum": [
            "approved",
            "draft",
            "needs_review",
            "deprecated"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation_errors": {
          "items": {
            "$ref": "#/$defs/SourceValidationErrorV1"
          },
          "title": "Validation Errors",
          "type": "array"
        }
      },
      "required": [
        "file",
        "document_id",
        "document_type",
        "status",
        "sha256",
        "validation_errors"
      ],
      "title": "SourceManifestEntryV1",
      "type": "object"
    },
    "SourceValidationErrorV1": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path",
        "code",
        "detail"
      ],
      "title": "SourceValidationErrorV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:source-manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo source-manifest versión 1.",
  "properties": {
    "documents": {
      "items": {
        "$ref": "#/$defs/SourceManifestEntryV1"
      },
      "title": "Documents",
      "type": "array"
    },
    "schema_version": {
      "const": "2.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "documents"
  ],
  "title": "SourceManifestV1",
  "type": "object"
}
