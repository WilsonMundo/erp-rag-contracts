  "description": "Contrato normativo reviewer-query-catalog versión 1.",
  "properties": {
    "catalog_version": {
      "pattern": "^\\d{4}\\.\\d{2}$",
      "title": "Catalog Version",
      "type": "string"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/QueryExampleDocumentSourceV1"
      },
      "title": "Documents",
      "type": "array"
    },
    "language": {
      "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
      "title": "Language",
      "type": "string"
    },
    "module": {
      "title": "Module",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "catalog_version",
    "module",
    "language",
    "documents"
  ],
  "title": "QueryExampleCatalogV1",
  "type": "object"
}
