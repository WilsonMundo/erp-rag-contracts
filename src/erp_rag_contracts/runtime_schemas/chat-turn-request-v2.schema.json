{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:erp-rag-contracts:schema:chat-turn-request:v2",
  "title": "ChatTurnRequestV2",
  "description": "Contrato general de entrada enviado por .NET a la API Python/LangGraph. Soporta mensajes del usuario, archivos, invocaciones explícitas, respuestas a aclaraciones y respuestas a confirmaciones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "conversation_id",
    "turn_id",
    "input",
    "runtime_context"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "2.0",
      "description": "Versión del contrato."
    },
    "request_id": {
      "$ref": "#/$defs/opaqueIdentifier",
      "description": "Identificador único de la llamada HTTP."
    },
    "conversation_id": {
      "$ref": "#/$defs/opaqueIdentifier",
      "description": "Identificador estable de la conversación y thread_id de LangGraph."
    },
    "turn_id": {
      "$ref": "#/$defs/opaqueIdentifier",
      "description": "Identificador único del turno."
    },
    "input": {
      "oneOf": [
        {
          "$ref": "#/$defs/userMessageInput"
        },
        {
          "$ref": "#/$defs/clarificationResponseInput"
        },
        {
          "$ref": "#/$defs/confirmationResponseInput"
        }
      ]
    },
    "runtime_context": {
      "$ref": "#/$defs/runtimeContext"
    },
    "expected_state_revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Revisión del estado que .NET espera reanudar. Es obligatoria para respuestas a aclaraciones y confirmaciones."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "input": {
            "properties": {
              "type": {
                "const": "clarification_response"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "then": {
        "required": [
          "expected_state_revision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "input": {
            "properties": {
              "type": {
                "const": "confirmation_response"
              }
            },
            "required": [
              "type"
            ]
          }
        }
      },
      "then": {
        "required": [
          "expected_state_revision"
        ]
      }
    }
  ],
  "$defs": {
    "opaqueIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "runtimeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_datetime",
        "timezone",
        "locale"
      ],
      "properties": {
        "current_datetime": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora autoritativa enviada por .NET."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "examples": [
            "America/Guatemala"
          ],
          "description": "Zona horaria IANA usada para resolver expresiones temporales."
        },
        "resolution_context_handle": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "locale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
          "examples": [
            "es-GT"
          ],
          "description": "Configuración regional del usuario."
        }
      }
    },
    "userMessageInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "user_message"
        },
        "contents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textContent"
              },
              {
                "$ref": "#/$defs/attachmentContent"
              }
            ]
          },
          "description": "Texto, archivos o ambos."
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        }
      },
      "anyOf": [
        {
          "required": [
            "contents"
          ]
        },
        {
          "required": [
            "invocation"
          ]
        }
      ]
    },
    "textContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        }
      }
    },
    "attachmentContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attachment_id",
        "original_name",
        "mime_type",
        "size_bytes",
        "sha256",
        "access"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "attachment"
        },
        "attachment_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "original_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "mime_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "Hash SHA-256 hexadecimal de 64 caracteres."
        },
        "access": {
          "$ref": "#/$defs/attachmentAccess"
        },
        "purpose_hint": {
          "type": "string",
          "enum": [
            "unknown",
            "catalog_import",
            "transaction_import",
            "business_document",
            "supporting_document",
            "image_capture"
          ],
          "default": "unknown"
        }
      }
    },
    "attachmentAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "url",
        "expires_at"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "signed_url"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocation_id",
        "action_id",
        "action_version",
        "source",
        "parameters"
      ],
      "properties": {
        "invocation_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "action_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
          "examples": [
            "catalog.products.import"
          ]
        },
        "action_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "source": {
          "type": "string",
          "enum": [
            "command_palette",
            "result_menu",
            "application_menu",
            "correction_flow",
            "chat_suggestion",
            "api"
          ]
        },
        "parameters": {
          "type": "object",
          "x-dynamic-map": true,
          "additionalProperties": true
        },
        "attachment_bindings": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/attachmentBinding"
          },
          "default": []
        }
      }
    },
    "attachmentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachment_id",
        "role"
      ],
      "properties": {
        "attachment_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$",
          "examples": [
            "source_file",
            "document_image"
          ]
        }
      }
    },
    "clarificationResponseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "clarification_response"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "clarification_response"
        },
        "clarification_response": {
          "$ref": "#/$defs/clarificationResponse"
        }
      }
    },
    "clarificationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clarification_id",
        "field",
        "value"
      ],
      "properties": {
        "clarification_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "oneOf": [
            {
              "$ref": "#/$defs/textClarificationValue"
            },
            {
              "$ref": "#/$defs/singleChoiceClarificationValue"
            },
            {
              "$ref": "#/$defs/multipleChoiceClarificationValue"
            },
            {
              "$ref": "#/$defs/dateClarificationValue"
            },
            {
              "$ref": "#/$defs/dateRangeClarificationValue"
            },
            {
              "$ref": "#/$defs/numberClarificationValue"
            },
            {
              "$ref": "#/$defs/entitySelectionClarificationValue"
            },
            {
              "$ref": "#/$defs/entityMultiSelectionClarificationValue"
            },
            {
              "$ref": "#/$defs/booleanClarificationValue"
            }
          ]
        }
      }
    },
    "textClarificationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      }
    },
    "singleChoiceClarificationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "option_id"
      ],
      "properties": {
        "kind": {
          "const": "single_choice"
        },
        "option_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        }
      }
    },
    "multipleChoiceClarificationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "option_ids"
      ],
      "properties": {
        "kind": {
          "const": "multiple_choice"
        },
        "option_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaqueIdentifier"
          }
        }
      }
    },
    "dateClarificationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "date"
        },
        "value": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "dateRangeClarificationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "start_date",
        "end_date_exclusive"
      ],
      "properties": {
        "kind": {
          "const": "date_range"
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date_exclusive": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "numberClarificationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "number"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "entitySelectionClarificationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entity_type",
        "entity_id"
      ],
      "properties": {
        "kind": {
          "const": "entity_selection"
        },
        "entity_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "entity_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "display_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "entityMultiSelectionClarificationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entity_type",
        "entity_ids"
      ],
      "properties": {
        "kind": {
          "const": "entity_multi_selection"
        },
        "entity_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "entity_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/opaqueIdentifier"
          }
        }
      }
    },
    "booleanClarificationValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "boolean"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "confirmationResponseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "confirmation_response"
      ],
      "properties": {
        "type": {
          "type": "string",
          "const": "confirmation_response"
        },
        "confirmation_response": {
          "$ref": "#/$defs/confirmationResponse"
        }
      }
    },
    "confirmationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmation_id",
        "decision"
      ],
      "properties": {
        "confirmation_id": {
          "$ref": "#/$defs/opaqueIdentifier"
        },
        "decision": {
          "type": "string",
          "enum": [
            "confirm",
            "cancel"
          ]
        }
      }
    }
  },
  "examples": [
    {
      "contract_version": "2.0",
      "request_id": "req-001",
      "conversation_id": "conv-001",
      "turn_id": "turn-001",
      "input": {
        "type": "user_message",
        "contents": [
          {
            "kind": "text",
            "text": "Importa estos artículos"
          },
          {
            "kind": "attachment",
            "attachment_id": "att-001",
            "original_name": "articulos.xlsx",
            "mime_type": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            "size_bytes": 24580,
            "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            "access": {
              "mode": "signed_url",
              "url": "https://backend.example.com/files/temporary/att-001",
              "expires_at": "2026-07-30T01:00:00-06:00"
            }
          }
        ],
        "invocation": {
          "invocation_id": "inv-001",
          "action_id": "catalog.products.import",
          "action_version": "1.0",
          "source": "command_palette",
          "parameters": {},
          "attachment_bindings": [
            {
              "attachment_id": "att-001",
              "role": "source_file"
            }
          ]
        }
      },
      "runtime_context": {
        "current_datetime": "2026-07-30T00:18:00-06:00",
        "timezone": "America/Guatemala",
        "locale": "es-GT"
      }
    }
  ]
}
