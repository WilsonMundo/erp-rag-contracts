{
  "$id": "urn:erp-rag-contracts:schema:dashboard-filter-mapping:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "entity_binding": {
            "type": "string"
          }
        },
        "required": [
          "entity_binding"
        ]
      },
      "then": {
        "properties": {
          "source_path": {
            "const": "value"
          }
        }
      }
    }
  ],
  "description": "Contrato normativo runtime dashboard-filter-mapping versión 1.",
  "properties": {
    "dashboard_filter_mapping_version": {
      "const": "1.0",
      "title": "Dashboard Filter Mapping Version",
      "type": "string"
    },
    "entity_binding": {
      "anyOf": [
        {
          "enum": [
            "entity_id",
            "binding_value"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entity Binding"
    },
    "source_path": {
      "enum": [
        "value",
        "start",
        "end_exclusive"
      ],
      "title": "Source Path",
      "type": "string"
    },
    "target_parameter": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
      "title": "Target Parameter",
      "type": "string"
    }
  },
  "required": [
    "dashboard_filter_mapping_version",
    "source_path",
    "target_parameter"
  ],
  "title": "DashboardFilterMappingV1",
  "type": "object"
}
