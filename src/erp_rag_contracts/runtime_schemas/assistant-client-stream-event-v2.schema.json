{
  "$defs": {
    "SpokenSummaryV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "result_summary",
          "title": "Kind",
          "type": "string"
        },
        "spoken_summary_version": {
          "const": "1.0",
          "title": "Spoken Summary Version",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "spoken_summary_version",
        "kind",
        "text"
      ],
      "title": "SpokenSummaryV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:assistant-client-stream-event:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo runtime assistant-client-stream-event versión 2.",
  "properties": {
    "conversation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Conversation Id",
      "type": "string"
    },
    "event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Event Id",
      "type": "string"
    },
    "event_version": {
      "const": "2.0",
      "title": "Event Version",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object",
      "x-dynamic-map": true
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Request Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "spoken_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/SpokenSummaryV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "turn_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Turn Id",
      "type": "string"
    },
    "type": {
      "enum": [
        "turn.started",
        "turn.progress",
        "assistant.delta",
        "heartbeat",
        "query.result",
        "analytics.result",
        "query.narrative_pending",
        "query.narrative",
        "query.narrative_degraded",
        "turn.response",
        "turn.error"
      ],
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "sequence",
    "timestamp",
    "event_version",
    "request_id",
    "conversation_id",
    "turn_id",
    "type",
    "payload"
  ],
  "title": "AssistantClientStreamEventV2",
  "type": "object"
}
