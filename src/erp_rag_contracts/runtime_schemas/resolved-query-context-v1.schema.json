{
  "$defs": {
    "MetricMentionV1": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "pattern": "^[a-z][a-z0-9_]{0,79}$",
          "title": "Concept",
          "type": "string"
        },
        "mention": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Mention",
          "type": "string"
        }
      },
      "required": [
        "mention",
        "concept"
      ],
      "title": "MetricMentionV1",
      "type": "object"
    },
    "QuerySemanticPlanV1": {
      "additionalProperties": false,
      "properties": {
        "entity_references": {
          "items": {
            "$ref": "#/$defs/SemanticEntityReferenceV1"
          },
          "maxItems": 25,
          "title": "Entity References",
          "type": "array"
        },
        "filters": {
          "items": {
            "$ref": "#/$defs/SemanticMentionV1"
          },
          "maxItems": 30,
          "title": "Filters",
          "type": "array"
        },
        "grouping_mentions": {
          "items": {
            "$ref": "#/$defs/SemanticMentionV1"
          },
          "maxItems": 20,
          "title": "Grouping Mentions",
          "type": "array"
        },
        "metric_mentions": {
          "items": {
            "$ref": "#/$defs/MetricMentionV1"
          },
          "maxItems": 20,
          "title": "Metric Mentions",
          "type": "array"
        },
        "temporal_expression": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temporal Expression"
        },
        "version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "metric_mentions",
        "entity_references",
        "temporal_expression",
        "grouping_mentions",
        "filters"
      ],
      "title": "QuerySemanticPlanV1",
      "type": "object"
    },
    "ResolvedEntityBindingV1": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "entity_id",
            "binding_value"
          ],
          "title": "Kind",
          "type": "string"
        },
        "max_length": {
          "anyOf": [
            {
              "maximum": 4000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "sql_type": {
          "enum": [
            "tinyint",
            "smallint",
            "int",
            "bigint",
            "uniqueidentifier",
            "nvarchar"
          ],
          "title": "Sql Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "kind",
        "sql_type",
        "value"
      ],
      "title": "ResolvedEntityBindingV1",
      "type": "object"
    },
    "ResolvedEntityV1": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/ResolvedEntityBindingV1"
        },
        "display_text": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Display Text",
          "type": "string"
        },
        "entity_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "enum": [
            "branch",
            "customer",
            "product",
            "supplier",
            "seller",
            "document",
            "classification_level"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "mention": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Mention",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-z][a-z0-9_]{0,79}$",
          "title": "Ref",
          "type": "string"
        },
        "status": {
          "const": "resolved",
          "title": "Status",
          "type": "string"
        },
        "type_resolution": {
          "enum": [
            "explicit",
            "clarified"
          ],
          "title": "Type Resolution",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "entity_type",
        "mention",
        "type_resolution",
        "status",
        "entity_id",
        "display_text",
        "binding"
      ],
      "title": "ResolvedEntityV1",
      "type": "object"
    },
    "ResolvedTemporalBindingV1": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "sql_type": {
          "const": "datetime2",
          "default": "datetime2",
          "title": "Sql Type",
          "type": "string"
        },
        "value": {
          "format": "date-time",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "ResolvedTemporalBindingV1",
      "type": "object"
    },
    "ResolvedTemporalContextV1": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/ResolvedTemporalBindingV1"
          },
          "maxItems": 10,
          "title": "Bindings",
          "type": "array"
        },
        "end_exclusive": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Exclusive"
        },
        "start": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "status": {
          "enum": [
            "resolved",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "timezone": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "status",
        "timezone",
        "bindings"
      ],
      "title": "ResolvedTemporalContextV1",
      "type": "object"
    },
    "SemanticEntityReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "anyOf": [
            {
              "enum": [
                "branch",
                "customer",
                "product",
                "supplier",
                "seller",
                "document",
                "classification_level"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Type"
        },
        "mention": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Mention",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-z][a-z0-9_]{0,79}$",
          "title": "Ref",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type_resolution": {
          "enum": [
            "explicit",
            "clarified",
            "unknown"
          ],
          "title": "Type Resolution",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "entity_type",
        "mention",
        "type_resolution"
      ],
      "title": "SemanticEntityReferenceV1",
      "type": "object"
    },
    "SemanticMentionV1": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{0,79}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concept"
        },
        "mention": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Mention",
          "type": "string"
        }
      },
      "required": [
        "mention"
      ],
      "title": "SemanticMentionV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:resolved-query-context:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo runtime resolved-query-context versión 1.",
  "properties": {
    "entities": {
      "items": {
        "$ref": "#/$defs/ResolvedEntityV1"
      },
      "maxItems": 25,
      "title": "Entities",
      "type": "array"
    },
    "semantic_plan": {
      "$ref": "#/$defs/QuerySemanticPlanV1"
    },
    "temporal": {
      "$ref": "#/$defs/ResolvedTemporalContextV1"
    },
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "semantic_plan",
    "temporal",
    "entities"
  ],
  "title": "ResolvedQueryContextV1",
  "type": "object"
}
