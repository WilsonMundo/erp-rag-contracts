  "$id": "urn:erp-rag-contracts:schema:materialized-presentation:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo runtime materialized-presentation versión 2.",
  "properties": {
    "blocks": {
      "items": {
        "discriminator": {
          "mapping": {
            "chart": "#/$defs/MaterializedChartBlockV1",
            "data_grid": "#/$defs/MaterializedGridBlockV1",
            "gauge": "#/$defs/MaterializedGaugeBlockV1",
            "kpi": "#/$defs/MaterializedKpiBlockV1",
            "pivot_grid": "#/$defs/MaterializedPivotBlockV1"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/MaterializedKpiBlockV1"
          },
          {
            "$ref": "#/$defs/MaterializedGridBlockV1"
          },
          {
            "$ref": "#/$defs/MaterializedPivotBlockV1"
          },
          {
            "$ref": "#/$defs/MaterializedChartBlockV1"
          },
          {
            "$ref": "#/$defs/MaterializedGaugeBlockV1"
          }
        ]
      },
      "maxItems": 20,
      "title": "Blocks",
      "type": "array"
    },
    "capability_profile": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Capability Profile",
      "type": "string"
    },
    "layout": {
      "$ref": "#/$defs/PresentationLayoutV1"
    },
    "materialized_presentation_version": {
      "const": "2.0",
      "title": "Materialized Presentation Version",
      "type": "string"
    },
    "resolutions": {
      "items": {
        "$ref": "#/$defs/PresentationBlockResolutionV1"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Resolutions",
      "type": "array"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "materialized_presentation_version",
    "title",
    "capability_profile",
    "blocks",
    "resolutions",
    "layout"
  ],
  "title": "MaterializedPresentationV2",
  "type": "object"
}
