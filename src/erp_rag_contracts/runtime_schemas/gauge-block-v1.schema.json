        {
          "discriminator": {
            "mapping": {
              "field": "#/$defs/FieldValueReferenceV1",
              "resolved_reference": "#/$defs/ResolvedReferenceValueReferenceV1",
              "result_aggregate": "#/$defs/ResultAggregateValueReferenceV1"
            },
            "propertyName": "source"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FieldValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResultAggregateValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResolvedReferenceValueReferenceV1"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum"
    },
    "minimum": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "field": "#/$defs/FieldValueReferenceV1",
              "resolved_reference": "#/$defs/ResolvedReferenceValueReferenceV1",
              "result_aggregate": "#/$defs/ResultAggregateValueReferenceV1"
            },
            "propertyName": "source"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FieldValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResultAggregateValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResolvedReferenceValueReferenceV1"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum"
    },
    "ranges": {
      "items": {
        "$ref": "#/$defs/GaugeRangeV1"
      },
      "maxItems": 20,
      "title": "Ranges",
      "type": "array"
    },
    "target": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "field": "#/$defs/FieldValueReferenceV1",
              "resolved_reference": "#/$defs/ResolvedReferenceValueReferenceV1",
              "result_aggregate": "#/$defs/ResultAggregateValueReferenceV1"
            },
            "propertyName": "source"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FieldValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResultAggregateValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResolvedReferenceValueReferenceV1"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    },
    "title": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "value": {
      "discriminator": {
        "mapping": {
          "field": "#/$defs/FieldValueReferenceV1",
          "resolved_reference": "#/$defs/ResolvedReferenceValueReferenceV1",
          "result_aggregate": "#/$defs/ResultAggregateValueReferenceV1"
        },
        "propertyName": "source"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FieldValueReferenceV1"
        },
        {
          "$ref": "#/$defs/ResultAggregateValueReferenceV1"
        },
        {
          "$ref": "#/$defs/ResolvedReferenceValueReferenceV1"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "block_version",
    "block_id",
    "kind",
    "title",
    "value"
