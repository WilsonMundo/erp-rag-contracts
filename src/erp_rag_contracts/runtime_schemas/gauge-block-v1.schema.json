{
  "$defs": {
    "FieldValueReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Field",
          "type": "string"
        },
        "source": {
          "const": "field",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "field"
      ],
      "title": "FieldValueReferenceV1",
      "type": "object"
    },
    "GaugeRangeV1": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "discriminator": {
            "mapping": {
              "field": "#/$defs/FieldValueReferenceV1",
              "resolved_reference": "#/$defs/ResolvedReferenceValueReferenceV1",
              "result_aggregate": "#/$defs/ResultAggregateValueReferenceV1"
            },
            "propertyName": "source"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FieldValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResultAggregateValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResolvedReferenceValueReferenceV1"
            }
          ],
          "title": "End"
        },
        "label": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "start": {
          "discriminator": {
            "mapping": {
              "field": "#/$defs/FieldValueReferenceV1",
              "resolved_reference": "#/$defs/ResolvedReferenceValueReferenceV1",
              "result_aggregate": "#/$defs/ResultAggregateValueReferenceV1"
            },
            "propertyName": "source"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/FieldValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResultAggregateValueReferenceV1"
            },
            {
              "$ref": "#/$defs/ResolvedReferenceValueReferenceV1"
            }
          ],
          "title": "Start"
        }
      },
      "required": [
        "start",
        "end",
        "label"
      ],
      "title": "GaugeRangeV1",
      "type": "object"
    },
    "ResolvedReferenceValueReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "reference_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
          "title": "Reference Id",
          "type": "string"
        },
        "source": {
          "const": "resolved_reference",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "reference_id"
      ],
      "title": "ResolvedReferenceValueReferenceV1",
      "type": "object"
    },
    "ResultAggregateValueReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count"
          ],
          "title": "Aggregation",
          "type": "string"
        },
        "field": {
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
          "title": "Field",
          "type": "string"
        },
        "scope": {
          "const": "result_set",
          "title": "Scope",
          "type": "string"
        },
        "source": {
          "const": "result_aggregate",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "scope",
        "field",
        "aggregation"
      ],
      "title": "ResultAggregateValueReferenceV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:gauge-block:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo runtime gauge-block versión 1.",
  "properties": {
    "block_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$",
      "title": "Block Id",
      "type": "string"
    },
    "block_version": {
      "const": "1.0",
      "title": "Block Version",
      "type": "string"
    },
    "kind": {
      "const": "gauge",
      "title": "Kind",
      "type": "string"
    },
    "maximum": {
