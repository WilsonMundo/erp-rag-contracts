{
  "$id": "urn:erp-rag-contracts:schema:entity-set-reference:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Contrato normativo runtime entity-set-reference versión 1.",
  "properties": {
    "binding_source": {
      "enum": [
        "entity_id",
        "binding_value"
      ],
      "title": "Binding Source",
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "branch",
        "customer",
        "product",
        "supplier",
        "seller",
        "document"
      ],
      "title": "Entity Type",
      "type": "string"
    },
    "maximum_selections": {
      "maximum": 10,
      "minimum": 1,
      "title": "Maximum Selections",
      "type": "integer"
    },
    "member_refs": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,79}$",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Member Refs",
      "type": "array"
    },
    "minimum_selections": {
      "default": 1,
      "maximum": 10,
      "minimum": 1,
      "title": "Minimum Selections",
      "type": "integer"
    },
    "parameter_slots": {
      "items": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Parameter Slots",
      "type": "array"
    },
    "required": {
      "default": true,
      "title": "Required",
      "type": "boolean"
    },
    "selection_mode": {
      "enum": [
        "single",
        "multiple"
      ],
      "title": "Selection Mode",
      "type": "string"
    },
    "set_ref": {
      "pattern": "^[a-z][a-z0-9_]{0,79}$",
      "title": "Set Ref",
      "type": "string"
    }
  },
  "required": [
    "set_ref",
    "entity_type",
    "selection_mode",
    "parameter_slots",
    "binding_source",
    "maximum_selections"
  ],
  "title": "EntitySetReferenceV1",
  "type": "object"
}
