  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "chart": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "chart"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "chart": {
            "type": "object"
          }
        },
        "required": [
          "chart"
        ]
      }
    },
    {
      "else": {
        "properties": {
          "kpi": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "kpi"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "kpi": {
            "type": "object"
          }
        },
        "required": [
          "kpi"
        ]
      }
    },
    {
      "else": {
        "properties": {
          "summary": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "summary"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "summary": {
            "type": "object"
          }
        },
        "required": [
          "summary"
        ]
      }
    }
  ],
  "description": "Contrato normativo runtime analytics-presentation-block versión 1.",
  "properties": {
    "block_id": {
