{
  "$defs": {
    "AnalyticsChartPresentationV1": {
      "additionalProperties": false,
      "properties": {
        "category_field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Category Field",
          "type": "string"
        },
        "orientation": {
          "enum": [
            "horizontal",
            "vertical"
          ],
          "title": "Orientation",
          "type": "string"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/AnalyticsChartSeriesV1"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Series",
          "type": "array"
        },
        "type": {
          "enum": [
            "bar",
            "line",
            "area"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "orientation",
        "category_field",
        "series"
      ],
      "title": "AnalyticsChartPresentationV1",
      "type": "object"
    },
    "AnalyticsChartSeriesV1": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field"
      ],
      "title": "AnalyticsChartSeriesV1",
      "type": "object"
    }
  },
  "$id": "urn:erp-rag-contracts:schema:analytics-presentation-block:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "chart": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "chart"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "chart": {
            "type": "object"
          }
        },
        "required": [
          "chart"
        ]
      }
    }
  ],
  "description": "Contrato normativo runtime analytics-presentation-block versión 1.",
  "properties": {
    "block_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Block Id",
      "type": "string"
    },
    "chart": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalyticsChartPresentationV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "enum": [
        "table",
        "kpi",
        "chart"
      ],
      "title": "Kind",
      "type": "string"
    },
    "source_output_id": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Source Output Id",
      "type": "string"
    }
  },
  "required": [
    "block_id",
    "source_output_id",
    "kind"
  ],
  "title": "AnalyticsPresentationBlockV1",
  "type": "object"
}
