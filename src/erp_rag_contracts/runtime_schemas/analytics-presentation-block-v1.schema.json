        {
          "$ref": "#/$defs/AnalyticsSummaryPresentationV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "block_id",
    "source_output_id",
    "kind"
  ],
  "title": "AnalyticsPresentationBlockV1",
  "type": "object"
}
